  "iterate": { "afterRelease": "manual", "maxIterations": 25, "maxTasksPerIteration": 8, "convergeScore": 9 },
  "dependencies": {
    "enabled": true, "maxPerProduct": 25, "minWeeklyDownloads": 20000, "maxStaleDays": 730,
    "allowedLicenses": "^(MIT|ISC|BSD-[23]-Clause|Apache-2\\.0|0BSD|MPL-2\\.0|BlueOak-1\\.0\\.0)",
    "blocklist": [],
    "preferred": {
      "web framework / routing": "express (or fastify)",
      "request validation / schemas": "zod",
      "password hashing": "bcryptjs",
      "sessions": "express-session (cookie store) or cookie-session",
      "JWT / JWS / JWE": "jose",
      "OAuth2 / OpenID Connect client": "openid-client",
      "OAuth2 server-side helpers": "oauth4webapi",
      "security headers": "helmet",
      "CSRF": "csrf-csrf",
      "rate limiting": "express-rate-limit",
      "logging": "pino",
      "dates": "date-fns",
      "markdown": "marked (+ dompurify via isomorphic-dompurify for sanitising)",
      "CSV": "csv-parse / csv-stringify",
      "YAML": "yaml",
      "file uploads": "multer",
      "email (inactive until configured)": "nodemailer",
