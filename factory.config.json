  "providers": {
    "github": { "type": "openai", "baseUrl": "https://models.github.ai/inference", "apiKeyEnv": "GITHUB_MODELS_TOKEN", "enabled": false, "dailyTokenCap": 500000, "maxOutputTokens": 8192 },
    "openai": { "type": "openai", "baseUrl": "https://api.openai.com/v1", "apiKeyEnv": "OPENAI_API_KEY", "enabled": false, "dailyTokenCap": 500000, "maxOutputTokens": 8192 },
    "anthropic": { "type": "anthropic", "baseUrl": "https://api.anthropic.com", "apiKeyEnv": "ANTHROPIC_API_KEY", "enabled": false, "dailyTokenCap": 500000, "maxOutputTokens": 8192 },
    "openrouter": { "type": "openai", "baseUrl": "https://openrouter.ai/api/v1", "apiKeyEnv": "OPENROUTER_API_KEY", "enabled": false, "dailyTokenCap": 500000, "maxOutputTokens": 8192 }
  },
  "contextTokens": 16384,
  "platforms": {
    "frontend": ["React + TypeScript + Vite", "Angular + TypeScript"],
    "backend": ["Node.js LTS + TypeScript + Express/Fastify/NestJS", ".NET LTS + ASP.NET Core"],
    "cloud": ["AWS", "Azure", "GCP", "self-hosted", "local-only"],
